// Site Manager dialog: list of saved sites (CRUD) with an inline editor.
// Rust port of ui/SiteManagerDialog.cpp (QTableWidget + ConnectionDialog).
//
// NOTE: Window already provides a built-in `visible` property, so it is NOT
// re-declared here (re-declaring it would be a compile error). Rust code can
// call `set_visible(...)`, `show()`, or `hide()` on the component handle.

import { Button, CheckBox, ComboBox, LineEdit, ListView, Palette, ScrollView, SpinBox } from "std-widgets.slint";
import { PasswordEdit, BrowseEdit } from "widgets.slint";
import { Labels } from "labels.slint";

// One clickable column header cell (sort direction glyph included). The
// table's four headers share it; each call site sets its share of the row
// width (`width: 34%`, ...).
component SortHeader inherits TouchArea {
    in property <string> text;
    in property <int> column;
    in property <int> sort-column;
    in property <bool> sort-ascending;
    callback sort-requested(int);
    mouse-cursor: pointer;
    clicked => { root.sort-requested(root.column); }
    HorizontalLayout {
        spacing: 2px;
        Text {
            text: root.text;
            font-weight: 700;
            vertical-alignment: center;
        }
        Text {
            text: root.sort-column == root.column ? (root.sort-ascending ? "▲" : "▼") : "";
            font-size: 10px;
            vertical-alignment: center;
            color: Palette.foreground;
        }
    }
}

// One row of the site table (subset of SessionOptions for display).
export struct SiteRow {
    id: string,
    name: string,
    protocol: string,
    host: string,
    username: string,
    // Route summary for the table (e.g. "2 routes" / "auto · 2 routes").
    route-summary: string,
}

// One alternate-route row of the editor's routes list.
export struct RouteRow {
    label: string,
    // "host[:port]" or "(inherit)".
    endpoint: string,
    // "direct", "SOCKS5 proxy", "HTTP proxy", "jump bastion".
    transport: string,
    // Last probe outcome ("3 ms", "unreachable", "—").
    probe: string,
}

export component SiteManagerDialog inherits Window {
    title: @tr("Site Manager");
    // preferred-* sets the initial size; fixed width/height would lock the
    // window so the OS cannot resize it (Slint Window contract).
    preferred-width: 760px;
    preferred-height: 540px;
    min-width: 600px;
    min-height: 420px;
    background: Palette.background;

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    // Table model (set from Rust, see src/site_manager.rs).
    in-out property <[SiteRow]> rows;

    // Inline editor visibility.
    in-out property <bool> editor-visible;

    // Inline editor fields (mirroring the SessionOptions essentials).
    in-out property <string> editor-name;
    in-out property <string> editor-protocol; // storage name: sftp/scp/ftp/ftps/webdav/smb/telnet
    in-out property <string> editor-host;
    in-out property <int> editor-port;
    in-out property <string> editor-username;
    in-out property <string> editor-password;
    in-out property <string> editor-key-path;
    in-out property <string> editor-key-passphrase;
    in-out property <bool> editor-save-credentials: true;
    in-out property <string> editor-scp-mode: "auto"; // auto | scp-only
    in-out property <string> editor-webdav-scheme: "https"; // https | http
    in-out property <int> editor-known-hosts-policy; // 0 strict, 1 accept-new, 2 off
    in-out property <string> editor-known-hosts-path;
    in-out property <int> editor-integrity-policy; // 0 off, 1 optional, 2 required
    in-out property <bool> editor-ftps-verify-peer;
    in-out property <string> editor-ftps-ca-cert;
    in-out property <bool> editor-webdav-verify-peer: true;
    in-out property <string> editor-webdav-ca-cert;
    in-out property <string> editor-smb-domain;
    in-out property <bool> editor-telnet-tls;
    in-out property <bool> editor-telnet-verify-peer: true;
    in-out property <string> editor-telnet-ca-cert;
    in-out property <bool> editor-telnet-auto-login: true;
    in-out property <int> editor-proxy-type; // 0 none, 1 socks5, 2 http-connect
    in-out property <string> editor-proxy-host;
    in-out property <int> editor-proxy-port;
    in-out property <string> editor-proxy-username;
    in-out property <string> editor-proxy-password;
    in-out property <string> editor-jump-host;
    in-out property <int> editor-jump-port: 22;
    in-out property <bool> editor-jump-enabled;
    in-out property <string> editor-jump-username;
    in-out property <string> editor-jump-key-path;
    // true while adding a new site, false while editing an existing one
    // (drives the "Add site"/"Edit site" heading).
    in-out property <bool> editor-mode-is-add: true;
    // SFTP/SCP share the SSH-specific rows (key path, known_hosts, jump).
    property <bool> editor-is-ssh: root.editor-protocol == "sftp" || root.editor-protocol == "scp";
    // Stable UUID of the site being edited; empty while adding.
    in-out property <string> editing-site-id;
    // Sort state shown in the header glyphs (kept in sync by Rust).
    in-out property <int> sort-column: 0;
    in-out property <bool> sort-ascending: true;

    // ---- Alternate routes (Rust-only feature) ---------------------------
    // Route rows shown in the editor list (full data lives in Rust; the
    // widgets below only edit/inspect).
    in-out property <[RouteRow]> editor-routes;
    // Index of the selected route row (-1 = none).
    in-out property <int> route-selected-row: -1;
    // 0 = automatic (probe + failover), 1 = manual (pinned).
    in-out property <int> editor-route-policy: 0;
    // Pinned route label ("" = primary endpoint); model is set from Rust.
    in-out property <string> editor-pinned-label;
    in-out property <[string]> pinned-route-model: ["Primary"];
    // Summary line under the list ("LAN 3 ms · Cloudflare n/a").
    in-out property <string> probe-status;
    // Route sub-editor (add/edit one route).
    in-out property <bool> route-editor-visible: false;
    in-out property <bool> route-editor-is-edit: false;
    // 0 direct, 1 socks5, 2 http-connect, 3 ssh-jump.
    in-out property <int> route-editor-type: 0;
    in-out property <string> route-editor-label;
    in-out property <string> route-editor-host;
    in-out property <int> route-editor-port;
    in-out property <string> route-editor-username;
    in-out property <string> route-editor-key-path;
    in-out property <string> route-editor-proxy-host;
    in-out property <int> route-editor-proxy-port: 1080;
    in-out property <string> route-editor-proxy-username;
    in-out property <string> route-editor-jump-host;
    in-out property <int> route-editor-jump-port: 22;
    in-out property <string> route-editor-jump-username;
    in-out property <string> route-editor-jump-key-path;
    // "Copy endpoint from another saved site" merge panel.
    in-out property <bool> merge-visible: false;
    in-out property <[string]> merge-source-model;
    in-out property <string> merge-source;
    in-out property <bool> merge-delete-source: true;

    // Show/hide toggles for the three credential fields (Qt passToggle /
    // keyPassToggle / proxyPassToggle in ConnectionDialog.cpp).
    property <bool> show-password: false;
    property <bool> show-key-passphrase: false;
    property <bool> show-proxy-password: false;

    // Selection state (kept in-out so Rust can restore/reselect; -1 = none).
    in-out property <int> current-row: -1;
    property <int> last-click-row: -1;
    property <bool> has-selection: root.current-row >= 0 && root.current-row < root.rows.length;

    callback new-requested();
    callback edit-requested(string);
    callback delete-requested(string);
    callback connect-requested(string);
    // Fired on every row click; the Rust side runs the 400 ms double-click
    // detection (the timer-based detection below hit a Slint 1.17 codegen
    // bug where a Timer referenced from a `for` delegate generated
    // `_self.timer0.restart()` on the delegate component, which has no
    // timer). The Rust handler re-emits `connect-site-requested` on a
    // double click.
    callback site-clicked(int);
    // Fired only on row double-click (alias of connect-requested, kept separate
    // so the main-window workstream can wire double-click independently).
    callback connect-site-requested(string);
    callback close-requested();
    // Import the concrete Host aliases from ~/.ssh/config as saved sites
    // (Rust-only feature; the C++ Site Manager had no import).
    callback import-ssh-config-requested();
    callback save-requested();
    callback editor-cancel-requested();
    // "Choose…" file browse buttons (field: private-key/known-hosts/ftps-ca/webdav-ca/jump-key).
    callback browse-path-requested(string);
    // Fired when the user picks another protocol (Rust resets the port).
    callback protocol-changed();
    // Fired when the user picks another proxy type (Rust applies the
    // jump-host exclusion and the default proxy port, like
    // ConnectionDialog's proxyType_ currentIndexChanged handler).
    callback proxy-type-changed();
    // Fired when the user toggles the jump-host checkbox (Rust resets the
    // proxy to "Direct", like the jumpEnabled_ toggled handler).
    callback jump-enabled-changed();
    // Fired when the user switches the WebDAV scheme (Rust follows the port
    // 443<->80 when it still holds the previous scheme default).
    callback webdav-scheme-changed();
    // Fired when the user toggles Telnet TLS (Rust follows the port 23<->992
    // when it still holds the previous default).
    callback telnet-tls-changed();
    // Fired from the header cells (0 name, 1 protocol, 2 host, 3 user,
    // 4 routes).
    callback sort-requested(int);

    // ---- Alternate-route callbacks (Rust-only feature) ------------------
    // Opens the route sub-editor for a new route.
    callback route-add-requested();
    // Opens the route sub-editor for the selected row.
    callback route-edit-requested(int);
    // Removes the given route row.
    callback route-remove-requested(int);
    // Stores the sub-editor fields (add or replace).
    callback route-save-requested();
    callback route-editor-cancel-requested();
    // Probes the primary endpoint plus all routes and refreshes the list.
    callback probe-routes-requested();
    // Opens the "copy endpoint from another saved site" panel.
    callback merge-open-requested();
    callback merge-confirm-requested();
    callback merge-cancel-requested();
    // Fires when a route row is clicked (selection).
    callback route-row-clicked(int);

    function move-selection(delta: int) {
        if (root.rows.length == 0) {
            return;
        }
        if (root.current-row < 0) {
            root.current-row = delta > 0 ? 0 : root.rows.length - 1;
        } else {
            root.current-row = min(root.rows.length - 1, max(0, root.current-row + delta));
        }
        root.ensure-row-visible(root.current-row);
    }

    // Keeps a row visible (called from Rust after reselect too).
    public function ensure-row-visible(idx: int) {
        if (root.rows.length == 0 || idx < 0 || idx >= root.rows.length) {
            return;
        }
        site-list.viewport-y = min(
            max(0px, idx * 30px - (site-list.height - 30px) / 2),
            max(0px, root.rows.length * 30px - site-list.height),
        );
    }

    FocusScope {
        width: 100%;
        height: 100%;
        KeyBinding {
            keys: @keys(Escape);
            activated => { root.close-requested(); }
        }

    VerticalLayout {
        padding: 12px;
        spacing: 8px;

        // Header row (click a header to sort, like the Qt table).
        HorizontalLayout {
            spacing: 0px;
            SortHeader {
                width: 26%;
                text: @tr("Name");
                column: 0;
                sort-column: root.sort-column;
                sort-ascending: root.sort-ascending;
                sort-requested(col) => { root.sort-requested(col); }
            }
            SortHeader {
                width: 14%;
                text: @tr("Protocol");
                column: 1;
                sort-column: root.sort-column;
                sort-ascending: root.sort-ascending;
                sort-requested(col) => { root.sort-requested(col); }
            }
            SortHeader {
                width: 25%;
                text: @tr("Host");
                column: 2;
                sort-column: root.sort-column;
                sort-ascending: root.sort-ascending;
                sort-requested(col) => { root.sort-requested(col); }
            }
            SortHeader {
                width: 14%;
                text: @tr("User");
                column: 3;
                sort-column: root.sort-column;
                sort-ascending: root.sort-ascending;
                sort-requested(col) => { root.sort-requested(col); }
            }
            SortHeader {
                width: 21%;
                text: @tr("Routes");
                column: 4;
                sort-column: root.sort-column;
                sort-ascending: root.sort-ascending;
                sort-requested(col) => { root.sort-requested(col); }
            }
        }

        // Site table (hand-rolled rows so the model stays [SiteRow]).
        Rectangle {
            border-width: 1px;
            border-color: Palette.border;
            vertical-stretch: 1;
            clip: true;
            site-list-scope := FocusScope {
                width: parent.width;
                height: parent.height;
                key-pressed(event) => {
                    if (event.text == Key.UpArrow) {
                        root.move-selection(-1);
                        return accept;
                    } else if (event.text == Key.DownArrow) {
                        root.move-selection(1);
                        return accept;
                    } else if (event.text == Key.Return) {
                        if (root.has-selection) {
                            root.connect-requested(root.rows[root.current-row].name);
                        }
                        return accept;
                    }
                    reject
                }
                site-list := ListView {
                    for site[idx] in root.rows : Rectangle {
                        height: 30px;
                        background: idx == root.current-row
                            ? Palette.accent-background
                            : (mod(idx, 2) == 0 ? Palette.background : Palette.alternate-background);
                        TouchArea {
                            clicked => {
                                root.current-row = idx;
                                // Keyboard navigation (Up/Down/Enter) applies
                                // while the table has focus.
                                site-list-scope.focus();
                                // Double-click detection happens in Rust
                                // (site_manager::handle_row_click) because the
                                // Timer-based variant triggered a Slint 1.17
                                // codegen bug.
                                root.site-clicked(idx);
                            }
                        }
                        HorizontalLayout {
                            spacing: 0px;
                            Text {
                                text: site.name;
                                overflow: elide;
                                width: 26%;
                                vertical-alignment: center;
                                color: idx == root.current-row ? Palette.accent-foreground : Palette.foreground;
                                Tooltip { text: @markdown("\{site.name}"); }
                            }
                            Text {
                                text: site.protocol;
                                overflow: elide;
                                width: 14%;
                                vertical-alignment: center;
                                color: idx == root.current-row ? Palette.accent-foreground : Palette.foreground;
                                Tooltip { text: @markdown("\{site.protocol}"); }
                            }
                            Text {
                                text: site.host;
                                overflow: elide;
                                width: 25%;
                                vertical-alignment: center;
                                color: idx == root.current-row ? Palette.accent-foreground : Palette.foreground;
                                Tooltip { text: @markdown("\{site.host}"); }
                            }
                            Text {
                                text: site.username;
                                overflow: elide;
                                width: 14%;
                                vertical-alignment: center;
                                color: idx == root.current-row ? Palette.accent-foreground : Palette.foreground;
                                Tooltip { text: @markdown("\{site.username}"); }
                            }
                            Text {
                                text: site.route-summary;
                                overflow: elide;
                                width: 21%;
                                vertical-alignment: center;
                                font-size: 11px;
                                color: idx == root.current-row ? Palette.accent-foreground : Palette.foreground;
                                Tooltip { text: @markdown("\{site.route-summary}"); }
                            }
                        }
                    }
                }
            }
        }

        // Inline editor (visible while adding/editing a site).
        if root.editor-visible : Rectangle {
            border-width: 1px;
            border-color: Palette.border;
            height: 400px;
            ScrollView {
                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;
                    Text {
                        text: root.editor-mode-is-add ? @tr("Add site") : @tr("Edit site");
                        font-weight: 700;
                    }
                    GridLayout {
                        spacing: 6px;
                        Row {
                            Text {
                                text: @tr("Site name:");
                                width: 190px;
                                vertical-alignment: center;
                            }
                            LineEdit {
                                text <=> root.editor-name;
                                placeholder-text: @tr("My server");
                                horizontal-stretch: 1;
                            }
                        }
                        Row {
                            Text {
                                text: @tr("Protocol:");
                                width: 190px;
                                vertical-alignment: center;
                            }
                            ComboBox {
                                model: ["SFTP", "SCP", "FTP", "FTPS", "WebDAV", "SMB", "Telnet"];
                                current-value: Labels.protocol-label(root.editor-protocol);
                                horizontal-stretch: 1;
                                selected(value) => {
                                    // Only fire when the protocol actually
                                    // changes (Qt currentIndexChanged).
                                    if (root.editor-protocol != Labels.protocol-storage-name(value)) {
                                        root.editor-protocol = Labels.protocol-storage-name(value);
                                        root.protocol-changed();
                                    }
                                }
                            }
                        }
                        Row {
                            Text {
                                text: @tr("SCP mode:");
                                width: 190px;
                                vertical-alignment: center;
                                visible: root.editor-protocol == "scp";
                            }
                            ComboBox {
                                model: [
                                    @tr("Automatic (SCP with SFTP fallback)"),
                                    @tr("SCP only (disable SFTP fallback)"),
                                ];
                                current-value: root.editor-scp-mode == "scp-only"
                                    ? @tr("SCP only (disable SFTP fallback)")
                                    : @tr("Automatic (SCP with SFTP fallback)");
                                horizontal-stretch: 1;
                                visible: root.editor-protocol == "scp";
                                selected(value) => {
                                    root.editor-scp-mode = value == @tr("SCP only (disable SFTP fallback)")
                                        ? "scp-only"
                                        : "auto";
                                }
                            }
                        }
                        Row {
                            Text {
                                text: @tr("Host / Port:");
                                width: 190px;
                                vertical-alignment: center;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                horizontal-stretch: 1;
                                LineEdit {
                                    text <=> root.editor-host;
                                    placeholder-text: Labels.host-placeholder(root.editor-protocol);
                                    horizontal-stretch: 1;
                                }
                                SpinBox {
                                    minimum: 1;
                                    maximum: 65535;
                                    value <=> root.editor-port;
                                    width: 110px;
                                    Tooltip { text: @markdown("Server port for the selected protocol"); }
                                }
                            }
                        }
                        Row {
                            Text {
                                text: @tr("User:");
                                width: 190px;
                                vertical-alignment: center;
                            }
                            LineEdit {
                                text <=> root.editor-username;
                                placeholder-text: @tr("user");
                                horizontal-stretch: 1;
                            }
                        }
                        Row {
                            Text {
                                text: @tr("Password:");
                                width: 190px;
                                vertical-alignment: center;
                            }
                            PasswordEdit {
                                text <=> root.editor-password;
                                show <=> root.show-password;
                                horizontal-stretch: 1;
                            }
                        }
                        Row {
                            Text {
                                text: @tr("Private key path:");
                                width: 190px;
                                vertical-alignment: center;
                                visible: root.editor-is-ssh;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                horizontal-stretch: 1;
                                visible: root.editor-is-ssh;
                                BrowseEdit {
                                    text <=> root.editor-key-path;
                                    placeholder: "~/.ssh/id_ed25519";
                                    horizontal-stretch: 1;
                                    browse-requested => { root.browse-path-requested("private-key"); }
                                }
                            }
                        }
                        Row {
                            Text {
                                text: @tr("Key passphrase:");
                                width: 190px;
                                vertical-alignment: center;
                                visible: root.editor-is-ssh;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                horizontal-stretch: 1;
                                visible: root.editor-is-ssh;
                                PasswordEdit {
                                    text <=> root.editor-key-passphrase;
                                    show <=> root.show-key-passphrase;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                        Row {
                            Text {
                                text: @tr("Proxy:");
                                width: 190px;
                                vertical-alignment: center;
                            }
                            ComboBox {
                                model: [@tr("Direct (no proxy)"), "SOCKS5", "HTTP CONNECT"];
                                current-value: Labels.proxy-label(root.editor-proxy-type);
                                horizontal-stretch: 1;
                                selected(value) => {
                                    root.editor-proxy-type = Labels.proxy-index(value);
                                    root.proxy-type-changed();
                                }
                            }
                        }
                        Row {
                            Text {
                                text: @tr("Proxy host / port:");
                                width: 190px;
                                vertical-alignment: center;
                                visible: root.editor-proxy-type > 0;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                horizontal-stretch: 1;
                                visible: root.editor-proxy-type > 0;
                                LineEdit {
                                    text <=> root.editor-proxy-host;
                                    placeholder-text: @tr("proxy.example.com");
                                    horizontal-stretch: 1;
                                }
                                SpinBox {
                                    minimum: 1;
                                    maximum: 65535;
                                    value <=> root.editor-proxy-port;
                                    width: 110px;
                                }
                            }
                        }
                        Row {
                            Text {
                                text: @tr("Proxy user:");
                                width: 190px;
                                vertical-alignment: center;
                                visible: root.editor-proxy-type > 0;
                            }
                            LineEdit {
                                text <=> root.editor-proxy-username;
                                placeholder-text: @tr("optional");
                                horizontal-stretch: 1;
                                visible: root.editor-proxy-type > 0;
                            }
                        }
                        Row {
                            Text {
                                text: @tr("Proxy password:");
                                width: 190px;
                                vertical-alignment: center;
                                visible: root.editor-proxy-type > 0;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                horizontal-stretch: 1;
                                visible: root.editor-proxy-type > 0;
                                PasswordEdit {
                                    text <=> root.editor-proxy-password;
                                    show <=> root.show-proxy-password;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                        Row {
                            Text {
                                text: "";
                                width: 190px;
                                vertical-alignment: center;
                                visible: root.editor-is-ssh;
                            }
                            CheckBox {
                                text: @tr("Use SSH jump host (bastion)");
                                checked <=> root.editor-jump-enabled;
                                horizontal-stretch: 1;
                                visible: root.editor-is-ssh;
                                toggled => { root.jump-enabled-changed(); }
                            }
                        }
                        Row {
                            Text {
                                text: @tr("Jump host / port:");
                                width: 190px;
                                vertical-alignment: center;
                                visible: root.editor-is-ssh && root.editor-jump-enabled;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                horizontal-stretch: 1;
                                visible: root.editor-is-ssh && root.editor-jump-enabled;
                                LineEdit {
                                    text <=> root.editor-jump-host;
                                    placeholder-text: @tr("bastion.example.com");
                                    horizontal-stretch: 1;
                                }
                                SpinBox {
                                    minimum: 1;
                                    maximum: 65535;
                                    value <=> root.editor-jump-port;
                                    width: 110px;
                                }
                            }
                        }
                        Row {
                            Text {
                                text: @tr("Jump user:");
                                width: 190px;
                                vertical-alignment: center;
                                visible: root.editor-is-ssh && root.editor-jump-enabled;
                            }
                            LineEdit {
                                text <=> root.editor-jump-username;
                                placeholder-text: @tr("optional");
                                horizontal-stretch: 1;
                                visible: root.editor-is-ssh && root.editor-jump-enabled;
                            }
                        }
                        Row {
                            Text {
                                text: @tr("Jump private key:");
                                width: 190px;
                                vertical-alignment: center;
                                visible: root.editor-is-ssh && root.editor-jump-enabled;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                horizontal-stretch: 1;
                                visible: root.editor-is-ssh && root.editor-jump-enabled;
                                BrowseEdit {
                                    text <=> root.editor-jump-key-path;
                                    placeholder: @tr("optional");
                                    horizontal-stretch: 1;
                                    browse-requested => { root.browse-path-requested("jump-key"); }
                                }
                            }
                        }
                        Row {
                            Text {
                                text: @tr("known_hosts:");
                                width: 190px;
                                vertical-alignment: center;
                                visible: root.editor-is-ssh;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                horizontal-stretch: 1;
                                visible: root.editor-is-ssh;
                                BrowseEdit {
                                    text <=> root.editor-known-hosts-path;
                                    placeholder: "~/.ssh/known_hosts";
                                    horizontal-stretch: 1;
                                    browse-requested => { root.browse-path-requested("known-hosts"); }
                                }
                            }
                        }
                        Row {
                            Text {
                                text: @tr("Policy:");
                                width: 190px;
                                vertical-alignment: center;
                                visible: root.editor-is-ssh;
                            }
                            ComboBox {
                                model: [
                                    @tr("Strict"),
                                    @tr("Accept new (TOFU)"),
                                    @tr("No verification (double confirmation, expires in 15 min)"),
                                ];
                                current-value: Labels.kh-policy-label(root.editor-known-hosts-policy);
                                horizontal-stretch: 1;
                                visible: root.editor-is-ssh;
                                selected(value) => {
                                    root.editor-known-hosts-policy = Labels.kh-policy-index(value);
                                }
                            }
                        }
                        Row {
                            Text {
                                text: @tr("Integrity:");
                                width: 190px;
                                vertical-alignment: center;
                                visible: root.editor-protocol == "sftp";
                            }
                            ComboBox {
                                model: [
                                    @tr("Off (not recommended)"),
                                    @tr("Optional (recommended)"),
                                    @tr("Required (strict)"),
                                ];
                                current-value: Labels.integrity-label(root.editor-integrity-policy);
                                horizontal-stretch: 1;
                                visible: root.editor-protocol == "sftp";
                                selected(value) => {
                                    root.editor-integrity-policy = Labels.integrity-index(value);
                                }
                                Tooltip {
                                    text: @markdown("Checksum verification for resume and final transfer validation.");
                                }
                            }
                        }
                        Row {
                            Text {
                                text: "";
                                width: 190px;
                                vertical-alignment: center;
                                visible: root.editor-protocol == "ftps";
                            }
                            CheckBox {
                                text: @tr("Verify FTPS server certificate (recommended)");
                                checked <=> root.editor-ftps-verify-peer;
                                horizontal-stretch: 1;
                                visible: root.editor-protocol == "ftps";
                            }
                        }
                        Row {
                            Text {
                                text: @tr("FTPS CA bundle:");
                                width: 190px;
                                vertical-alignment: center;
                                visible: root.editor-protocol == "ftps";
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                horizontal-stretch: 1;
                                visible: root.editor-protocol == "ftps";
                                BrowseEdit {
                                    text <=> root.editor-ftps-ca-cert;
                                    placeholder: @tr("System CA bundle");
                                    horizontal-stretch: 1;
                                    browse-requested => { root.browse-path-requested("ftps-ca"); }
                                }
                            }
                        }
                        Row {
                            Text {
                                text: @tr("WebDAV scheme:");
                                width: 190px;
                                vertical-alignment: center;
                                visible: root.editor-protocol == "webdav";
                            }
                            ComboBox {
                                model: [
                                    @tr("HTTPS (recommended)"),
                                    @tr("HTTP (insecure)"),
                                ];
                                current-value: Labels.webdav-scheme-label(root.editor-webdav-scheme);
                                horizontal-stretch: 1;
                                visible: root.editor-protocol == "webdav";
                                selected(value) => {
                                    root.editor-webdav-scheme = Labels.webdav-scheme-storage(value);
                                    root.webdav-scheme-changed();
                                }
                            }
                        }
                        Row {
                            Text {
                                text: "";
                                width: 190px;
                                vertical-alignment: center;
                                visible: root.editor-protocol == "webdav" && root.editor-webdav-scheme == "https";
                            }
                            CheckBox {
                                text: @tr("Verify WebDAV server certificate (recommended)");
                                checked <=> root.editor-webdav-verify-peer;
                                horizontal-stretch: 1;
                                visible: root.editor-protocol == "webdav" && root.editor-webdav-scheme == "https";
                            }
                        }
                        Row {
                            Text {
                                text: @tr("WebDAV CA bundle:");
                                width: 190px;
                                vertical-alignment: center;
                                visible: root.editor-protocol == "webdav" && root.editor-webdav-scheme == "https";
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                horizontal-stretch: 1;
                                visible: root.editor-protocol == "webdav" && root.editor-webdav-scheme == "https";
                                BrowseEdit {
                                    text <=> root.editor-webdav-ca-cert;
                                    placeholder: @tr("System CA bundle");
                                    horizontal-stretch: 1;
                                    browse-requested => { root.browse-path-requested("webdav-ca"); }
                                }
                            }
                        }
                        Row {
                            Text {
                                text: @tr("Domain (workgroup):");
                                width: 190px;
                                vertical-alignment: center;
                                visible: root.editor-protocol == "smb";
                            }
                            LineEdit {
                                text <=> root.editor-smb-domain;
                                placeholder-text: @tr("optional");
                                horizontal-stretch: 1;
                                visible: root.editor-protocol == "smb";
                            }
                        }
                        Row {
                            Text {
                                text: "";
                                width: 190px;
                                vertical-alignment: center;
                                visible: root.editor-protocol == "telnet";
                            }
                            CheckBox {
                                text: @tr("Telnet over TLS (secure telnet, port 992)");
                                checked <=> root.editor-telnet-tls;
                                horizontal-stretch: 1;
                                visible: root.editor-protocol == "telnet";
                                toggled => { root.telnet-tls-changed(); }
                            }
                        }
                        Row {
                            Text {
                                text: "";
                                width: 190px;
                                vertical-alignment: center;
                                visible: root.editor-protocol == "telnet" && root.editor-telnet-tls;
                            }
                            CheckBox {
                                text: @tr("Verify TLS server certificate (recommended)");
                                checked <=> root.editor-telnet-verify-peer;
                                horizontal-stretch: 1;
                                visible: root.editor-protocol == "telnet" && root.editor-telnet-tls;
                            }
                        }
                        Row {
                            Text {
                                text: @tr("Telnet CA bundle:");
                                width: 190px;
                                vertical-alignment: center;
                                visible: root.editor-protocol == "telnet" && root.editor-telnet-tls;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                horizontal-stretch: 1;
                                visible: root.editor-protocol == "telnet" && root.editor-telnet-tls;
                                BrowseEdit {
                                    text <=> root.editor-telnet-ca-cert;
                                    placeholder: @tr("System CA bundle");
                                    horizontal-stretch: 1;
                                    browse-requested => { root.browse-path-requested("telnet-ca"); }
                                }
                            }
                        }
                        Row {
                            Text {
                                text: "";
                                width: 190px;
                                vertical-alignment: center;
                                visible: root.editor-protocol == "telnet";
                            }
                            CheckBox {
                                text: @tr("Log in automatically using the stored credentials");
                                checked <=> root.editor-telnet-auto-login;
                                horizontal-stretch: 1;
                                visible: root.editor-protocol == "telnet";
                            }
                        }
                        Row {
                            Text {
                                text: "";
                                width: 190px;
                                vertical-alignment: center;
                            }
                            CheckBox {
                                text: @tr("Save passwords/passphrases");
                                checked <=> root.editor-save-credentials;
                                horizontal-stretch: 1;
                            }
                        }

                        // ---- Alternate routes (Rust-only feature) ----
                        Row {
                            Text {
                                text: @tr("Route policy:");
                                width: 190px;
                                vertical-alignment: center;
                            }
                            ComboBox {
                                model: [
                                    @tr("Automatic (use the fastest route)"),
                                    @tr("Manual (always use the route below)"),
                                ];
                                current-value: root.editor-route-policy == 1
                                    ? @tr("Manual (always use the route below)")
                                    : @tr("Automatic (use the fastest route)");
                                horizontal-stretch: 1;
                                selected(value) => {
                                    root.editor-route-policy = value == @tr("Manual (always use the route below)") ? 1 : 0;
                                }
                            }
                        }
                        Row {
                            Text {
                                text: @tr("Pinned route:");
                                width: 190px;
                                vertical-alignment: center;
                                visible: root.editor-route-policy == 1;
                            }
                            ComboBox {
                                model: root.pinned-route-model;
                                current-value: root.editor-pinned-label;
                                enabled: root.editor-route-policy == 1;
                                horizontal-stretch: 1;
                                selected(value) => {
                                    root.editor-pinned-label = value;
                                }
                                visible: root.editor-route-policy == 1;
                            }
                        }
                        Row {
                            Text {
                                text: @tr("Alternate routes:");
                                width: 190px;
                                vertical-alignment: top;
                            }
                            VerticalLayout {
                                spacing: 6px;
                                horizontal-stretch: 1;
                                HorizontalLayout {
                                    spacing: 6px;
                                    Button {
                                        text: @tr("Add route…");
                                        clicked => { root.route-add-requested(); }
                                    }
                                    Button {
                                        text: @tr("Edit");
                                        enabled: root.route-selected-row >= 0;
                                        clicked => {
                                            if root.route-selected-row >= 0 {
                                                root.route-edit-requested(root.route-selected-row);
                                            }
                                        }
                                    }
                                    Button {
                                        text: @tr("Remove");
                                        enabled: root.route-selected-row >= 0;
                                        clicked => {
                                            if root.route-selected-row >= 0 {
                                                root.route-remove-requested(root.route-selected-row);
                                            }
                                        }
                                    }
                                    Button {
                                        text: @tr("From saved site…");
                                        clicked => { root.merge-open-requested(); }
                                    }
                                    Button {
                                        text: @tr("Probe");
                                        clicked => { root.probe-routes-requested(); }
                                        Tooltip {
                                            text: @markdown("Measure which endpoint answers first (TCP connect); used by *Automatic* route selection.");
                                        }
                                    }
                                }
                                Rectangle {
                                    border-width: 1px;
                                    border-color: Palette.border;
                                    height: 26px + 24px * min(3, max(1, root.editor-routes.length));
                                    visible: root.editor-routes.length > 0;
                                    clip: true;
                                    ListView {
                                        for route[idx] in root.editor-routes : Rectangle {
                                            height: 24px;
                                            background: idx == root.route-selected-row
                                                ? Palette.accent-background
                                                : (mod(idx, 2) == 0 ? Palette.background : Palette.alternate-background);
                                            TouchArea {
                                                clicked => { root.route-row-clicked(idx); }
                                            }
                                            HorizontalLayout {
                                                padding-left: 4px;
                                                spacing: 0px;
                                                Text {
                                                    text: route.label;
                                                    width: 90px;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                    font-size: 11px;
                                                    color: idx == root.route-selected-row ? Palette.accent-foreground : Palette.foreground;
                                                }
                                                Text {
                                                    text: route.endpoint;
                                                    horizontal-stretch: 1;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                    font-size: 11px;
                                                    color: idx == root.route-selected-row ? Palette.accent-foreground : Palette.foreground;
                                                }
                                                Text {
                                                    text: route.transport;
                                                    width: 150px;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                    font-size: 11px;
                                                    color: idx == root.route-selected-row ? Palette.accent-foreground : Palette.foreground;
                                                }
                                                Text {
                                                    text: route.probe;
                                                    width: 100px;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                    font-size: 11px;
                                                    color: idx == root.route-selected-row ? Palette.accent-foreground : Palette.foreground;
                                                }
                                            }
                                        }
                                    }
                                }
                                Text {
                                    text: root.probe-status;
                                    font-size: 11px;
                                    color: Palette.foreground;
                                    visible: root.probe-status != "";
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    // ---- Route sub-editor (add/edit one alternate route) ----
                    if root.route-editor-visible : Rectangle {
                        border-width: 1px;
                        border-color: Palette.border;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 6px;
                            Text {
                                text: root.route-editor-is-edit ? @tr("Edit route") : @tr("Add route");
                                font-weight: 700;
                            }
                            GridLayout {
                                spacing: 6px;
                                Row {
                                    Text {
                                        text: @tr("Label:");
                                        width: 150px;
                                        vertical-alignment: center;
                                    }
                                    LineEdit {
                                        text <=> root.route-editor-label;
                                        placeholder-text: @tr("LAN");
                                        horizontal-stretch: 1;
                                    }
                                }
                                Row {
                                    Text {
                                        text: @tr("Host / Port:");
                                        width: 150px;
                                        vertical-alignment: center;
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        horizontal-stretch: 1;
                                        LineEdit {
                                            text <=> root.route-editor-host;
                                            placeholder-text: @tr("empty = same as the site host");
                                            horizontal-stretch: 1;
                                        }
                                        SpinBox {
                                            minimum: 0;
                                            maximum: 65535;
                                            value <=> root.route-editor-port;
                                            width: 110px;
                                            Tooltip { text: @markdown("0 = inherit the site port"); }
                                        }
                                    }
                                }
                                Row {
                                    Text {
                                        text: @tr("User:");
                                        width: 150px;
                                        vertical-alignment: center;
                                    }
                                    LineEdit {
                                        text <=> root.route-editor-username;
                                        placeholder-text: @tr("empty = same as the site user");
                                        horizontal-stretch: 1;
                                    }
                                }
                                Row {
                                    Text {
                                        text: @tr("Transport:");
                                        width: 150px;
                                        vertical-alignment: center;
                                    }
                                    ComboBox {
                                        model: [
                                            @tr("Direct"),
                                            "SOCKS5",
                                            "HTTP CONNECT",
                                            @tr("SSH jump host"),
                                        ];
                                        current-value: root.route-editor-type == 3
                                            ? @tr("SSH jump host")
                                            : Labels.proxy-label(root.route-editor-type);
                                        horizontal-stretch: 1;
                                        selected(value) => {
                                            if (value == @tr("SSH jump host")) {
                                                root.route-editor-type = 3;
                                            } else {
                                                root.route-editor-type = Labels.proxy-index(value);
                                            }
                                        }
                                    }
                                }
                                Row {
                                    Text {
                                        text: @tr("Proxy host / port:");
                                        width: 150px;
                                        vertical-alignment: center;
                                        visible: root.route-editor-type == 1 || root.route-editor-type == 2;
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        horizontal-stretch: 1;
                                        visible: root.route-editor-type == 1 || root.route-editor-type == 2;
                                        LineEdit {
                                            text <=> root.route-editor-proxy-host;
                                            placeholder-text: @tr("proxy.example.com");
                                            horizontal-stretch: 1;
                                        }
                                        SpinBox {
                                            minimum: 1;
                                            maximum: 65535;
                                            value <=> root.route-editor-proxy-port;
                                            width: 110px;
                                        }
                                    }
                                }
                                Row {
                                    Text {
                                        text: @tr("Proxy user:");
                                        width: 150px;
                                        vertical-alignment: center;
                                        visible: root.route-editor-type == 1 || root.route-editor-type == 2;
                                    }
                                    LineEdit {
                                        text <=> root.route-editor-proxy-username;
                                        placeholder-text: @tr("optional");
                                        horizontal-stretch: 1;
                                        visible: root.route-editor-type == 1 || root.route-editor-type == 2;
                                    }
                                }
                                Row {
                                    Text {
                                        text: @tr("Jump host / port:");
                                        width: 150px;
                                        vertical-alignment: center;
                                        visible: root.route-editor-type == 3;
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        horizontal-stretch: 1;
                                        visible: root.route-editor-type == 3;
                                        LineEdit {
                                            text <=> root.route-editor-jump-host;
                                            placeholder-text: @tr("bastion or cloudflared alias");
                                            horizontal-stretch: 1;
                                        }
                                        SpinBox {
                                            minimum: 1;
                                            maximum: 65535;
                                            value <=> root.route-editor-jump-port;
                                            width: 110px;
                                        }
                                    }
                                }
                                Row {
                                    Text {
                                        text: @tr("Jump user:");
                                        width: 150px;
                                        vertical-alignment: center;
                                        visible: root.route-editor-type == 3;
                                    }
                                    LineEdit {
                                        text <=> root.route-editor-jump-username;
                                        placeholder-text: @tr("optional");
                                        horizontal-stretch: 1;
                                        visible: root.route-editor-type == 3;
                                    }
                                }
                                Row {
                                    Text {
                                        text: @tr("Private key path:");
                                        width: 150px;
                                        vertical-alignment: center;
                                        visible: root.editor-is-ssh;
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        horizontal-stretch: 1;
                                        visible: root.editor-is-ssh;
                                        BrowseEdit {
                                            text <=> root.route-editor-key-path;
                                            placeholder: @tr("empty = same as the site key");
                                            horizontal-stretch: 1;
                                            browse-requested => { root.browse-path-requested("route-key"); }
                                        }
                                        BrowseEdit {
                                            text <=> root.route-editor-jump-key-path;
                                            placeholder: @tr("jump key (optional)");
                                            visible: root.route-editor-type == 3;
                                            browse-requested => { root.browse-path-requested("route-jump-key"); }
                                        }
                                    }
                                }
                            }
                            Text {
                                text: @tr("Cloudflared / ProxyCommand bastions do not resolve in DNS; they are tried after measured routes instead of probed.");
                                font-size: 11px;
                                color: Palette.foreground;
                                wrap: word-wrap;
                                visible: root.route-editor-type == 3;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Rectangle { horizontal-stretch: 1; }
                                Button {
                                    text: @tr("Cancel");
                                    clicked => { root.route-editor-cancel-requested(); }
                                }
                                Button {
                                    text: @tr("OK");
                                    primary: true;
                                    clicked => { root.route-save-requested(); }
                                }
                            }
                        }
                    }

                    // ---- Merge panel (copy an endpoint from another site) ----
                    if root.merge-visible : Rectangle {
                        border-width: 1px;
                        border-color: Palette.border;
                        VerticalLayout {
                            padding: 8px;
                            spacing: 6px;
                            Text {
                                text: @tr("Add route from saved site");
                                font-weight: 700;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: @tr("Site:");
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    model: root.merge-source-model;
                                    current-value: root.merge-source;
                                    horizontal-stretch: 1;
                                    selected(value) => { root.merge-source = value; }
                                }
                            }
                            CheckBox {
                                text: @tr("Delete the source site after adding its route");
                                checked <=> root.merge-delete-source;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Rectangle { horizontal-stretch: 1; }
                                Button {
                                    text: @tr("Cancel");
                                    clicked => { root.merge-cancel-requested(); }
                                }
                                Button {
                                    text: @tr("Add route");
                                    primary: true;
                                    clicked => { root.merge-confirm-requested(); }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: @tr("Cancel");
                            clicked => {
                                root.editor-cancel-requested();
                            }
                        }
                        Button {
                            text: @tr("Save");
                            primary: true;
                            clicked => {
                                root.save-requested();
                            }
                        }
                    }
                }
            }
        }

        // Action buttons.
        HorizontalLayout {
            Button {
                text: @tr("Add");
                icon: @image-url("../../../assets/icons/action-new-file.svg");
                clicked => {
                    root.new-requested();
                }
            }
            Button {
                text: @tr("Edit");
                icon: @image-url("../../../assets/icons/action-rename.svg");
                enabled: root.has-selection;
                clicked => {
                    if root.has-selection {
                        root.edit-requested(root.rows[root.current-row].name);
                    }
                }
            }
            Button {
                text: @tr("Delete");
                icon: @image-url("../../../assets/icons/action-delete.svg");
                enabled: root.has-selection;
                clicked => {
                    if root.has-selection {
                        root.delete-requested(root.rows[root.current-row].name);
                    }
                }
            }
            Button {
                text: @tr("Import SSH config");
                clicked => {
                    root.import-ssh-config-requested();
                }
            }
            Button {
                text: @tr("Connect");
                icon: @image-url("../../../assets/icons/action-connect.svg");
                enabled: root.has-selection;
                clicked => {
                    if root.has-selection {
                        root.connect-requested(root.rows[root.current-row].name);
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Button {
                text: @tr("Close");
                clicked => {
                    root.close-requested();
                }
            }
        }
    }
    }
}
