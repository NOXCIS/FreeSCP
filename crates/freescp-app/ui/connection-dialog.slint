// Connection dialog (session fields + advanced options).
//
// The session-security sub-dialogs (host-key TOFU, keyboard-interactive
// prompt, "no verification" risk confirmation, alerts) live in
// security-dialogs.slint and are re-exported below.
//
// Slint port of ui/ConnectionDialog.cpp and the dialog parts of
// ui/MainWindowConnection.cpp (TOFU box, keyboard-interactive QInputDialog,
// no-verification double confirmation, UiAlerts boxes).
//
// Rust counterpart: crates/freescp-app/src/connect.rs.
//
// Property contract (connect.rs reads/writes every `in-out` property):
// - protocol:         0 SFTP, 1 SCP, 2 FTP, 3 FTPS, 4 WebDAV, 5 SMB, 6 Telnet
// - auth-mode:        0 password, 1 key (SSH protocols only)
// - proxy-type:       0 None, 1 SOCKS5, 2 HTTP CONNECT
// - known-hosts-policy: 0 Strict, 1 Accept new (TOFU), 2 Off
// - scp-mode:         0 Auto (SCP with SFTP fallback), 1 SCP only
// - integrity:        0 Off, 1 Optional, 2 Required
// - webdav-https:     true HTTPS (recommended), false HTTP (insecure)
// Extra UI-state properties used by connect.rs but not part of the session
// mapping contract: connecting, status-message, webdav-scheme (int mirror of
// webdav-https because ComboBox current-index is an int).

import { Button, CheckBox, ComboBox, LineEdit, Palette, ProgressIndicator, ScrollView, SpinBox } from "std-widgets.slint";
import { BrowseEdit, PasswordEdit } from "widgets.slint";

// HostKeyDialog, KbdIntPromptDialog, ConfirmTextDialog and AlertDialog live in
// security-dialogs.slint and are re-exported so connect.rs / transfer.rs keep
// using crate::ui::connection_dialog::*.
export * from "security-dialogs.slint";

export component ConnectionDialog inherits Window {
    title: @tr("Connect");
    // preferred-* sets the initial size; fixed width/height would lock the
    // window so the OS cannot resize it (Slint Window contract).
    preferred-width: 560px;
    preferred-height: 500px;
    min-width: 440px;
    min-height: 400px;
    background: Palette.background;

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    // ---- Session fields (contract) ----------------------------------------
    in-out property <int> protocol: 0;
    in-out property <string> host: "";
    in-out property <int> port: 22;
    in-out property <string> username: "";
    in-out property <int> auth-mode: 0;
    in-out property <string> password: "";
    in-out property <string> private-key-path: "";
    in-out property <string> private-key-passphrase: "";
    in-out property <bool> save-site: true;
    in-out property <bool> save-credentials: false;
    in-out property <string> site-name: "";

    // ---- Advanced group (contract) ----------------------------------------
    in-out property <int> proxy-type: 0;
    in-out property <string> proxy-host: "";
    in-out property <int> proxy-port: 1080;
    in-out property <string> proxy-username: "";
    in-out property <string> proxy-password: "";
    in-out property <bool> jump-enabled: false;
    in-out property <string> jump-host: "";
    in-out property <int> jump-port: 22;
    in-out property <string> jump-username: "";
    in-out property <string> jump-key-path: "";
    in-out property <string> known-hosts-path: "";
    in-out property <int> known-hosts-policy: 0;
    in-out property <int> scp-mode: 0;
    in-out property <int> integrity: 1;
    in-out property <bool> ftps-verify-peer: true;
    in-out property <string> ftps-ca-path: "";
    in-out property <bool> webdav-https: true;
    in-out property <bool> webdav-verify-peer: true;
    in-out property <string> webdav-ca-path: "";
    in-out property <string> smb-domain: "";
    // Telnet console settings (TLS + auto-login).
    in-out property <bool> telnet-tls: false;
    in-out property <bool> telnet-verify-peer: true;
    in-out property <string> telnet-ca-path: "";
    in-out property <bool> telnet-auto-login: true;

    // ---- UI state (not part of the session mapping) ------------------------
    in-out property <bool> connecting: false;
    in-out property <string> status-message: "";
    property <bool> advanced-expanded: false;
    property <bool> show-password: false;
    property <bool> show-key-passphrase: false;
    property <bool> show-proxy-password: false;
    in-out property <int> webdav-scheme: 0; // 0 HTTPS, 1 HTTP

    // ---- Callbacks (wired by connect.rs) -----------------------------------
    callback connect-requested();
    callback close-requested();
    callback cancel-requested();
    callback protocol-changed();
    callback webdav-scheme-changed();
    // The telnet port follows 23 <-> 992 while it still holds the previous
    // default (mirrors `webdav-scheme-changed`).
    callback telnet-tls-changed();
    callback proxy-type-changed();
    callback jump-enabled-changed();
    callback browse-path-requested(string);

    // Fire the Rust-side default-port/visibility logic on user selection.
    changed protocol => { root.protocol-changed(); }
    changed proxy-type => { root.proxy-type-changed(); }
    changed jump-enabled => { root.jump-enabled-changed(); }
    changed telnet-tls => { root.telnet-tls-changed(); }

    // Saving credentials only makes sense together with saving the site
    // (C++ ConnectionDialog.cpp: saveCredentials_ is disabled — and cleared —
    // when "Save to saved sites" is unchecked).
    changed save-site => {
        if (!root.save-site) { root.save-credentials = false; }
    }

    // Keep the ComboBox mirror and the bool property in sync (idempotent:
    // setting an equal value does not re-fire `changed`).
    changed webdav-https => { root.webdav-scheme = root.webdav-https ? 0 : 1; }
    changed webdav-scheme => {
        root.webdav-https = root.webdav-scheme == 0;
        root.webdav-scheme-changed();
    }

    FocusScope {
        width: 100%;
        height: 100%;
        KeyBinding {
            keys: @keys(Escape);
            activated => {
                if root.connecting {
                    root.cancel-requested();
                } else {
                    root.close-requested();
                }
            }
        }

    VerticalLayout {
        padding: 12px;
        spacing: 6px;

        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                width: parent.width;

                GridLayout {
                    spacing: 6px;
                    width: parent.width;
                    padding: 2px;

                    // Lead with connection identity; Save options sit below auth.
                    Text { text: @tr("Protocol:"); vertical-alignment: center; }
                    ComboBox {
                        model: ["SFTP", "SCP", "FTP", "FTPS", "WebDAV", "SMB", "Telnet"];
                        current-index <=> root.protocol;
                        width: 340px;
                    }
                    Text { text: @tr("Host / Port:"); vertical-alignment: center; }
                    HorizontalLayout {
                        spacing: 6px;
                        LineEdit {
                            text <=> root.host;
                            placeholder-text: root.protocol == 0 ? @tr("sftp.example.com")
                                : root.protocol == 1 ? @tr("scp.example.com")
                                : root.protocol == 2 ? @tr("ftp.example.com")
                                : root.protocol == 3 ? @tr("ftps.example.com")
                                : root.protocol == 4 ? @tr("webdav.example.com")
                                : root.protocol == 5 ? @tr("smb.example.com")
                                : @tr("telnet.example.com");
                            horizontal-stretch: 1;
                            width: 240px;
                        }
                        SpinBox {
                            value <=> root.port;
                            minimum: 1;
                            maximum: 65535;
                            width: 100px;
                        }
                    }
                    Text { text: @tr("User:"); vertical-alignment: center; }
                    LineEdit {
                        text <=> root.username;
                        placeholder-text: @tr("user");
                        width: 340px;
                    }
                    Text { text: @tr("Authentication:"); vertical-alignment: center; visible: root.protocol <= 1; }
                    ComboBox {
                        model: [@tr("Password"), @tr("Private key")];
                        current-index <=> root.auth-mode;
                        width: 340px;
                        visible: root.protocol <= 1;
                    }
                    Text { text: @tr("Password:"); vertical-alignment: center; visible: root.protocol >= 2 || root.auth-mode == 0; }
                    PasswordEdit {
                        text <=> root.password;
                        show <=> root.show-password;
                        visible: root.protocol >= 2 || root.auth-mode == 0;
                        horizontal-stretch: 1;
                    }
                    Text { text: @tr("Private key path:"); vertical-alignment: center; visible: root.protocol <= 1 && root.auth-mode == 1; }
                    BrowseEdit {
                        text <=> root.private-key-path;
                        placeholder: "~/.ssh/id_ed25519";
                        visible: root.protocol <= 1 && root.auth-mode == 1;
                        horizontal-stretch: 1;
                        browse-requested => { root.browse-path-requested("private-key"); }
                    }
                    Text { text: @tr("Key passphrase:"); vertical-alignment: center; visible: root.protocol <= 1 && root.auth-mode == 1; }
                    PasswordEdit {
                        text <=> root.private-key-passphrase;
                        show <=> root.show-key-passphrase;
                        visible: root.protocol <= 1 && root.auth-mode == 1;
                        horizontal-stretch: 1;
                    }
                    Text { text: @tr("SCP mode:"); vertical-alignment: center; visible: root.protocol == 1; }
                    ComboBox {
                        model: [@tr("Automatic (SCP with SFTP fallback)"), @tr("SCP only (disable SFTP fallback)")];
                        current-index <=> root.scp-mode;
                        width: 340px;
                        visible: root.protocol == 1;
                    }
                    Text { text: ""; }
                    CheckBox {
                        text: @tr("Save to saved sites");
                        checked <=> root.save-site;
                    }
                    Text { text: @tr("Site name:"); vertical-alignment: center; visible: root.save-site; }
                    LineEdit {
                        text <=> root.site-name;
                        placeholder-text: @tr("My server");
                        width: 340px;
                        visible: root.save-site;
                    }
                    Text { text: ""; }
                    CheckBox {
                        text: @tr("Save passwords/passphrases");
                        checked <=> root.save-credentials;
                        enabled: root.save-site;
                    }
                }

                Button {
                    text: @tr("Advanced…");
                    icon: root.advanced-expanded
                        ? @image-url("../../../assets/icons/action-chevron-up.svg")
                        : @image-url("../../../assets/icons/action-chevron-down.svg");
                    clicked => { root.advanced-expanded = !root.advanced-expanded; }
                }

                if root.advanced-expanded : GridLayout {
                    spacing: 6px;
                    width: parent.width;
                    padding: 2px;

                    Text { text: @tr("Proxy:"); vertical-alignment: center; }
                    ComboBox {
                        model: [@tr("Direct (no proxy)"), "SOCKS5", "HTTP CONNECT"];
                        current-index <=> root.proxy-type;
                        width: 340px;
                    }
                    Text { text: @tr("Proxy host / port:"); vertical-alignment: center; visible: root.proxy-type != 0; }
                    HorizontalLayout {
                        spacing: 6px;
                        visible: root.proxy-type != 0;
                        LineEdit {
                            text <=> root.proxy-host;
                            placeholder-text: @tr("proxy.example.com");
                            horizontal-stretch: 1;
                            width: 240px;
                        }
                        SpinBox {
                            value <=> root.proxy-port;
                            minimum: 1;
                            maximum: 65535;
                            width: 100px;
                        }
                    }
                    Text { text: @tr("Proxy user:"); vertical-alignment: center; visible: root.proxy-type != 0; }
                    LineEdit {
                        text <=> root.proxy-username;
                        placeholder-text: @tr("optional");
                        width: 340px;
                        visible: root.proxy-type != 0;
                    }
                    Text { text: @tr("Proxy password:"); vertical-alignment: center; visible: root.proxy-type != 0; }
                    PasswordEdit {
                        text <=> root.proxy-password;
                        show <=> root.show-proxy-password;
                        visible: root.proxy-type != 0;
                        horizontal-stretch: 1;
                    }
                    Text { text: ""; visible: root.protocol <= 1; }
                    CheckBox {
                        text: @tr("Use SSH jump host (bastion)");
                        checked <=> root.jump-enabled;
                        visible: root.protocol <= 1;
                    }
                    Text { text: @tr("Jump host / port:"); vertical-alignment: center; visible: root.protocol <= 1 && root.jump-enabled; }
                    HorizontalLayout {
                        spacing: 6px;
                        visible: root.protocol <= 1 && root.jump-enabled;
                        LineEdit {
                            text <=> root.jump-host;
                            placeholder-text: @tr("bastion.example.com");
                            horizontal-stretch: 1;
                            width: 240px;
                        }
                        SpinBox {
                            value <=> root.jump-port;
                            minimum: 1;
                            maximum: 65535;
                            width: 100px;
                        }
                    }
                    Text { text: @tr("Jump user:"); vertical-alignment: center; visible: root.protocol <= 1 && root.jump-enabled; }
                    LineEdit {
                        text <=> root.jump-username;
                        placeholder-text: @tr("optional");
                        width: 340px;
                        visible: root.protocol <= 1 && root.jump-enabled;
                    }
                    Text { text: @tr("Jump private key:"); vertical-alignment: center; visible: root.protocol <= 1 && root.jump-enabled; }
                    BrowseEdit {
                        text <=> root.jump-key-path;
                        placeholder: @tr("optional");
                        visible: root.protocol <= 1 && root.jump-enabled;
                        horizontal-stretch: 1;
                        browse-requested => { root.browse-path-requested("jump-key"); }
                    }
                    Text { text: @tr("known_hosts:"); vertical-alignment: center; visible: root.protocol <= 1; }
                    BrowseEdit {
                        text <=> root.known-hosts-path;
                        placeholder: "~/.ssh/known_hosts";
                        visible: root.protocol <= 1;
                        horizontal-stretch: 1;
                        browse-requested => { root.browse-path-requested("known-hosts"); }
                    }
                    Text { text: @tr("Policy:"); vertical-alignment: center; visible: root.protocol <= 1; }
                    ComboBox {
                        model: [@tr("Strict"), @tr("Accept new (TOFU)"), @tr("No verification (double confirmation, expires in 15 min)")];
                        current-index <=> root.known-hosts-policy;
                        width: 340px;
                        visible: root.protocol <= 1;
                    }
                    Text { text: @tr("Integrity:"); vertical-alignment: center; visible: root.protocol == 0; }
                    ComboBox {
                        model: [@tr("Off (not recommended)"), @tr("Optional (recommended)"), @tr("Required (strict)")];
                        current-index <=> root.integrity;
                        width: 340px;
                        visible: root.protocol == 0;
                    }
                    Text { text: ""; visible: root.protocol == 3; }
                    CheckBox {
                        text: @tr("Verify FTPS server certificate (recommended)");
                        checked <=> root.ftps-verify-peer;
                        visible: root.protocol == 3;
                    }
                    Text { text: @tr("FTPS CA bundle:"); vertical-alignment: center; visible: root.protocol == 3; }
                    BrowseEdit {
                        text <=> root.ftps-ca-path;
                        placeholder: @tr("System CA bundle");
                        visible: root.protocol == 3;
                        horizontal-stretch: 1;
                        browse-requested => { root.browse-path-requested("ftps-ca"); }
                    }
                    Text { text: @tr("WebDAV scheme:"); vertical-alignment: center; visible: root.protocol == 4; }
                    ComboBox {
                        model: [@tr("HTTPS (recommended)"), @tr("HTTP (insecure)")];
                        current-index <=> root.webdav-scheme;
                        width: 340px;
                        visible: root.protocol == 4;
                    }
                    Text { text: ""; visible: root.protocol == 4 && root.webdav-https; }
                    CheckBox {
                        text: @tr("Verify WebDAV server certificate (recommended)");
                        checked <=> root.webdav-verify-peer;
                        visible: root.protocol == 4 && root.webdav-https;
                    }
                    Text { text: @tr("WebDAV CA bundle:"); vertical-alignment: center; visible: root.protocol == 4 && root.webdav-https; }
                    BrowseEdit {
                        text <=> root.webdav-ca-path;
                        placeholder: @tr("System CA bundle");
                        visible: root.protocol == 4 && root.webdav-https;
                        horizontal-stretch: 1;
                        browse-requested => { root.browse-path-requested("webdav-ca"); }
                    }
                    Text { text: @tr("Domain (workgroup):"); vertical-alignment: center; visible: root.protocol == 5; }
                    LineEdit {
                        text <=> root.smb-domain;
                        placeholder-text: @tr("optional");
                        width: 340px;
                        visible: root.protocol == 5;
                    }
                    Text { text: ""; visible: root.protocol == 6; }
                    CheckBox {
                        text: @tr("Telnet over TLS (secure telnet, port 992)");
                        checked <=> root.telnet-tls;
                        visible: root.protocol == 6;
                    }
                    Text { text: ""; visible: root.protocol == 6 && root.telnet-tls; }
                    CheckBox {
                        text: @tr("Verify TLS server certificate (recommended)");
                        checked <=> root.telnet-verify-peer;
                        visible: root.protocol == 6 && root.telnet-tls;
                    }
                    Text { text: @tr("Telnet CA bundle:"); vertical-alignment: center; visible: root.protocol == 6 && root.telnet-tls; }
                    BrowseEdit {
                        text <=> root.telnet-ca-path;
                        placeholder: @tr("System CA bundle");
                        visible: root.protocol == 6 && root.telnet-tls;
                        horizontal-stretch: 1;
                        browse-requested => { root.browse-path-requested("telnet-ca"); }
                    }
                    Text { text: ""; visible: root.protocol == 6; }
                    CheckBox {
                        text: @tr("Log in automatically using the stored credentials");
                        checked <=> root.telnet-auto-login;
                        visible: root.protocol == 6;
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            ProgressIndicator {
                visible: root.connecting;
                indeterminate: true;
                width: 18px;
                height: 18px;
            }
            Text {
                text: root.status-message;
                visible: root.status-message != "";
                vertical-alignment: center;
            }
            Rectangle { } // spacer: pushes the buttons to the right
            Button {
                text: root.connecting ? @tr("Cancel connection") : @tr("Cancel");
                clicked => {
                    if root.connecting {
                        root.cancel-requested();
                    } else {
                        root.close-requested();
                    }
                }
            }
            Button {
                text: @tr("Connect");
                primary: true;
                enabled: !root.connecting;
                clicked => { root.connect-requested(); }
            }
        }
    }
    }
}

// Host-key TOFU confirmation moved to security-dialogs.slint.
