// Session tab bar (WinSCP-style): one tab per local+remote pane pair.
//
// Each tab header is a drop target: dropping the active pane selection onto
// it copies the selected remote entries into that tab (staged through a
// local temporary directory, see main.rs `queue_remote_to_remote`).
// The payload itself is opaque in Slint code (installed once from Rust); the
// source pane is read from the main window's `drag-source-pane` property, so
// the tab only reports which tab was targeted.

import { ToolIcon, Theme } from "widgets.slint";

// One tab-bar row. `subtitle` carries the protocol/host summary (empty while
// the tab browses local folders only).
export struct TabRow {
    title: string,
    subtitle: string,
    active: bool,
    connected: bool,
    busy: bool,
    // Console tab (Telnet terminal or SSH terminal workspace): the header
    // shows a terminal glyph instead of the connection dot's file-browser
    // meaning.
    terminal: bool,
}

// Compact ◀/▶ control overlaid on the overflow strip (does not affect layout
// width, which would otherwise create a tabs-overflow binding loop).
component TabScrollButton inherits TouchArea {
    in property <string> label;
    width: 18px;
    height: 26px;
    mouse-cursor: MouseCursor.pointer;

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: root.has-hover ? Theme.hover : Theme.bg-chrome;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.border;
    }
    Text {
        width: parent.width;
        height: parent.height;
        text: root.label;
        horizontal-alignment: center;
        vertical-alignment: center;
        color: root.enabled
            ? (root.has-hover ? Theme.text : Theme.text-dim)
            : Theme.text-faint;
        font-size: 10px;
    }
}

export component SessionTabBar inherits Rectangle {
    in property <[TabRow]> tabs;
    in property <int> active-tab: 0;
    // True while an in-app pane drag is in flight; gates the drop targets so
    // external drags (files from the desktop) are ignored.
    in property <bool> drag-active: false;

    callback tab-selected(int);
    callback tab-close-requested(int);
    callback new-tab-requested();
    callback tab-drop-received(int);

    height: 30px;
    background: Theme.bg-chrome;

    // Content wider than the visible Flickable → show scroll affordances.
    // Affordances are overlays (not layout siblings) so this check cannot
    // feed back into tabs-flick.width.
    property <bool> tabs-overflow: tabs-flick.viewport-width > tabs-flick.width + 0.5px;
    property <bool> can-scroll-left: root.tabs-overflow && tabs-flick.viewport-x < -0.5px;
    property <bool> can-scroll-right: root.tabs-overflow
        && tabs-flick.viewport-x > (tabs-flick.width - tabs-flick.viewport-width) + 0.5px;
    property <length> scroll-step: min(160px, max(80px, tabs-flick.width / 2));

    function scroll-tabs(delta: length) {
        tabs-flick.viewport-x = max(
            min(0px, tabs-flick.width - tabs-flick.viewport-width),
            min(0px, tabs-flick.viewport-x + delta),
        );
    }

    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 2px;
        vertical-stretch: 1;

        // Scrollable strip so many tabs do not crush each other or the
        // pinned new-tab control. Edge fades + ◀▶ sit on top of the strip.
        Rectangle {
            horizontal-stretch: 1;
            height: parent.height;
            background: Theme.bg-chrome;
            clip: true;

            tabs-flick := Flickable {
                width: 100%;
                height: parent.height;
                viewport-width: tab-strip.preferred-width;
                viewport-height: self.height;
                interactive: true;

                tab-strip := HorizontalLayout {
                    spacing: 2px;
                    padding-top: 2px;
                    padding-bottom: 2px;

                    for tab-row[i] in root.tabs : tab := Rectangle {
                        // Tab width follows the title, clamped so long host names elide
                        // instead of pushing the other tabs out of view.
                        width: min(220px, max(120px, title.preferred-width + subtitle.preferred-width + 52px + (tab-row.terminal ? 14px : 0px)));
                        height: 26px;
                        background: tab-row.active ? (tab-area.has-hover ? #34343b : Theme.bg-header)
                                                   : (tab-area.has-hover ? Theme.bg-stripe : Theme.bg-chrome);
                        border-radius: 4px;

                        // Drop target first so the title/close hit areas painted in front
                        // still win pointer events; Slint routes drops to the DropArea
                        // regardless of z-order.
                        tab-drop := DropArea {
                            width: parent.width;
                            height: parent.height;
                            can-drop(event) => {
                                return root.drag-active ? event.proposed-action : DragAction.none;
                            }
                            dropped(event) => {
                                root.tab-drop-received(i);
                                return event.proposed-action;
                            }
                        }

                        // Active-tab underline.
                        Rectangle {
                            y: parent.height - 2px;
                            width: parent.width;
                            height: 2px;
                            background: tab-row.active ? Theme.accent : #00000000;
                            border-radius: 1px;
                        }

                        // Connection state dot (green connected, amber busy, grey local).
                        Rectangle {
                            x: 8px;
                            y: (parent.height - self.height) / 2;
                            width: 7px;
                            height: 7px;
                            border-radius: 3.5px;
                            background: tab-row.busy ? Theme.warning
                                      : (tab-row.connected ? Theme.success : Theme.text-faint);
                        }

                        // Terminal tabs announce their workspace kind up front.
                        if tab-row.terminal : Image {
                            x: 19px;
                            y: (parent.height - self.height) / 2;
                            width: 12px;
                            height: 12px;
                            source: @image-url("../../../assets/icons/mode-terminal.svg");
                            colorize: tab-row.active ? #7fb2ea : Theme.text-dim;
                        }

                        title := Text {
                            x: tab-row.terminal ? 36px : 21px;
                            y: 0px;
                            width: parent.width - (tab-row.terminal ? 36px : 21px) - 20px;
                            height: parent.height;
                            text: tab-row.title;
                            vertical-alignment: center;
                            overflow: elide;
                            color: tab-row.active ? Theme.text : #c9c9cf;
                            font-size: 12px;
                        }

                        subtitle := Text {
                            // Kept for the width computation only; the bar shows one line.
                            visible: false;
                            text: tab-row.subtitle;
                        }

                        close-area := TouchArea {
                            x: parent.width - 19px;
                            y: (parent.height - 18px) / 2;
                            width: 18px;
                            height: 18px;
                            mouse-cursor: MouseCursor.pointer;
                            Rectangle {
                                width: parent.width;
                                height: parent.height;
                                background: close-area.has-hover ? #4a4a52 : #00000000;
                                border-radius: 3px;
                            }
                            Image {
                                width: 9px;
                                height: 9px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                source: @image-url("../../../assets/icons/action-clear.svg");
                                colorize: close-area.has-hover ? Theme.text : Theme.text-dim;
                            }
                            clicked => { root.tab-close-requested(i); }
                        }

                        tab-area := TouchArea {
                            x: 0px;
                            y: 0px;
                            width: parent.width - 19px;
                            height: parent.height;
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.tab-selected(i); }
                        }

                        Tooltip {
                            text: tab-row.subtitle == "" ? @markdown("\{tab-row.title}") : @markdown("\{tab-row.title}\n\{tab-row.subtitle}");
                        }
                    }
                }
            }

            // Soft chrome fades when the strip is scrolled away from an edge.
            if root.can-scroll-left : Rectangle {
                x: 0px;
                y: 0px;
                width: 24px;
                height: parent.height;
                background: @linear-gradient(90deg, Theme.bg-chrome, #00000000);
            }
            if root.can-scroll-right : Rectangle {
                x: parent.width - 24px;
                y: 0px;
                width: 24px;
                height: parent.height;
                background: @linear-gradient(90deg, #00000000, Theme.bg-chrome);
            }

            // ◀ ▶ sit on the edges so they never steal HorizontalLayout width.
            if root.tabs-overflow : TabScrollButton {
                x: 2px;
                y: (parent.height - self.height) / 2;
                label: "◀";
                enabled: root.can-scroll-left;
                clicked => { root.scroll-tabs(root.scroll-step); }
            }
            if root.tabs-overflow : TabScrollButton {
                x: parent.width - self.width - 2px;
                y: (parent.height - self.height) / 2;
                label: "▶";
                enabled: root.can-scroll-right;
                clicked => { root.scroll-tabs(-root.scroll-step); }
            }
        }

        // Pinned outside the scroll strip so it stays reachable.
        ToolIcon {
            tooltip: @tr("New session…");
            source: @image-url("../../../assets/icons/action-new-tab.svg");
            clicked => { root.new-tab-requested(); }
        }
    }
}
