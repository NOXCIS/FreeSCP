// Overwrite-conflict prompt with "apply to all" support. Port of the Qt
// QMessageBox used by the copy/move flows: Yes / No / Yes to All / No to All
// (ui/MainWindowLocalOps.cpp conflict prompts, transfer worker precheck).
//
// Rust counterpart: crates/freescp-app/src/main.rs
// (`prompt_overwrite_choice`); the transfer worker blocks on an mpsc
// channel while this window is shown, mirroring the C++ condition-variable
// wait in the transfer manager.

import { Button, Palette } from "std-widgets.slint";
import { DialogFooter } from "widgets.slint";

export component OverwriteDialog inherits Window {
    title: @tr("Overwrite confirmation");
    // preferred-* sets the initial size; fixed width/height would lock the
    // window so the OS cannot resize it (Slint Window contract).
    preferred-width: 560px;
    preferred-height: 360px;
    min-width: 440px;
    min-height: 280px;
    background: Palette.background;

    in-out property <string> message: "";
    in-out property <string> source-info: "";
    in-out property <string> dest-info: "";
    in-out property <bool> can-resume: false;

    callback overwrite();
    callback skip();
    callback overwrite-all();
    callback skip-all();
    callback resume();
    // Abort the remaining transfer batch (distinct from Skip this file).
    callback cancel();

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    FocusScope {
        width: 100%;
        height: 100%;
        KeyBinding {
            keys: @keys(Escape);
            activated => { root.cancel(); }
        }

        VerticalLayout {
            padding: 16px;
            spacing: 8px;

            Text {
                text: root.message;
                wrap: word-wrap;
            }
            if root.source-info != "" : Text {
                text: @tr("Source: ") + root.source-info;
                wrap: word-wrap;
                font-size: 12px;
                color: Palette.control-foreground;
            }
            if root.dest-info != "" : Text {
                text: @tr("Destination: ") + root.dest-info;
                wrap: word-wrap;
                font-size: 12px;
                color: Palette.control-foreground;
            }
            Text {
                text: @tr("Skip leaves this file unchanged. Cancel stops the rest of the transfer.");
                color: Palette.control-foreground;
                font-size: 12px;
                wrap: word-wrap;
            }
            Rectangle { vertical-stretch: 1; }
            DialogFooter {
                Button {
                    text: @tr("Cancel");
                    clicked => { root.cancel(); }
                }
                Button {
                    text: @tr("Skip");
                    primary: true;
                    clicked => { root.skip(); }
                }
                if root.can-resume : Button {
                    text: @tr("Resume");
                    clicked => { root.resume(); }
                }
                Button {
                    text: @tr("Overwrite");
                    clicked => { root.overwrite(); }
                }
                Button {
                    text: @tr("Skip all");
                    clicked => { root.skip-all(); }
                }
                Button {
                    text: @tr("Overwrite all");
                    clicked => { root.overwrite-all(); }
                }
            }
        }
    }
}
